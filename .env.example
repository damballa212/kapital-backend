DATABASE_URL=postgres://user:pass@ep-xxx.pooler.neon.tech/kapital?sslmode=require
EVOLUTION_API_URL=https://your-evolution-api-host
EVOLUTION_API_KEY=your-api-key-here
EVOLUTION_INSTANCE=your-instance-name

# Token que Evolution API envía en cada webhook (Header: authorization o x-webhook-token)
# Configurar en Evolution API: Settings → Webhook → Auth Token
# Si no se define, el webhook acepta cualquier request (modo legacy)
EVOLUTION_WEBHOOK_SECRET=

# Origen permitido para CORS — dominio del frontend en producción
ALLOWED_ORIGIN=https://kapital-app-prod.web.app

# Service account de Firebase Admin en base64
# Obtener en: Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
# Convertir: base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_SA_B64=
